{
  "name": "podcast-chapter-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:ops && npm run test:silence && npm run test:loudness",
    "test:ops": "esbuild scripts/test-chapterOps.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-ops.mjs && node node_modules/.cache/test-ops.mjs",
    "test:silence": "esbuild scripts/test-silence.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-silence.mjs && node node_modules/.cache/test-silence.mjs",
    "test:loudness": "esbuild scripts/test-loudness.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-loudness.mjs && node node_modules/.cache/test-loudness.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
